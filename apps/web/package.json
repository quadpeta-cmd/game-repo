{
  "name": "game-hub-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "predev": "node scripts/generate-games-index.mjs",
    "prebuild": "node scripts/generate-games-index.mjs",
    "test": "node --test public/games/**/*.test.mjs",
    "test:hub:play-smoke": "tsx --tsconfig tsconfig.app.json --test scripts/hub-play-smoke.test.ts",
    "test:hub:build-smoke": "tsx --tsconfig tsconfig.app.json --test scripts/hub-build-smoke.test.ts",
    "test:hub:e2e": "tsx --tsconfig tsconfig.app.json --test scripts/hub-play-e2e.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "tsx": "^4.19.2",
    "jsdom": "^26.1.0",
    "playwright": "^1.54.0"
  }
}
