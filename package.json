{
  "name": "game-hub",
  "private": true,
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:signaling": "npm --prefix services/signaling run dev",
    "build": "npm --prefix apps/web run build",
    "preview": "npm --prefix apps/web run preview",
    "test:pong-solo": "node --test apps/web/public/games/pong-solo/game-logic.test.mjs",
    "test:pong-online": "node --test apps/web/public/games/pong-online/game-logic.test.mjs",
    "test:dodger": "node --test apps/web/public/games/dodger/game-logic.test.mjs",
    "test:games:runtime": "node scripts/game-runtime-smoke.mjs",
    "test:games": "npm run test:pong-solo && npm run test:pong-online && npm run test:dodger && npm run test:gold-miner && npm run test:games:runtime && npm run test:hub:play-smoke && npm run test:hub:build-smoke && npm run test:hub:e2e",
    "test:gold-miner": "node --test apps/web/public/games/gold-miner/tests/*.test.mjs",
    "test:gold-miner:perf": "node --test apps/web/public/games/gold-miner/tests/perf.test.mjs",
    "test:hub:play-smoke": "npm --prefix apps/web run test:hub:play-smoke",
    "test:hub:build-smoke": "npm --prefix apps/web run test:hub:build-smoke",
    "test:hub:e2e": "npm --prefix apps/web run test:hub:e2e",
    "test:hub:e2e:docker": "node scripts/run-hub-e2e-docker.mjs"
  }
}
